# Copy to .env and adjust. All values have local-friendly defaults in
# roughapp/config.py, so an empty .env still runs on SQLite.

# SQLAlchemy database URL.
#   local (default): sqlite:///data/roughapp.db
#   docker/postgres: postgresql+psycopg://roughapp:roughapp@db:5432/roughapp
DATABASE_URL=sqlite:///data/roughapp.db

# JWT signing key — MUST be a long random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# JWT lifetime in days.
ACCESS_TOKEN_EXPIRE_DAYS=30

# Guest session TTL (hours) and background cleanup interval (minutes; 0 = only on startup).
GUEST_SESSION_EXPIRE_HOURS=24
GUEST_CLEANUP_INTERVAL_MINUTES=60
